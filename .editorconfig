root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,json,yml,yaml,md}]
indent_style = space

[*.cs]
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

# Bloqueio síncrono em código assíncrono é erro de build (CA-N02.2).
[*.cs]
# Espera síncrona (.Result, .Wait(), GetAwaiter().GetResult())
dotnet_diagnostic.VSTHRD002.severity = error
# Chamada síncrona quando existe versão assíncrona
dotnet_diagnostic.VSTHRD103.severity = error
# Métodos async void
dotnet_diagnostic.VSTHRD100.severity = error
